# Copia este archivo a `.env` y completa los valores reales.
# `.env` NO se sube a git (está en .gitignore).

# Server
PORT=3000
NODE_ENV=development

# Database PostgreSQL
# En el servidor de producción usar 127.0.0.1 y la contraseña real del Postgres del servidor.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=turingtech
DB_USER=postgres
DB_PASSWORD=pon-aqui-la-contrasena-real

# JWT
JWT_SECRET=cambia-esto-por-una-clave-segura-en-produccion
JWT_EXPIRES_IN=7d

# Email — Microsoft Graph (producción; DigitalOcean bloquea SMTP saliente 25/465/587)
# Entra ID → App registration → permiso de APLICACIÓN Microsoft Graph "Mail.Send" + Grant admin consent.
# Si estas 4 vars están seteadas, el envío va por Graph; si no, usa el SMTP de abajo.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MAIL_SENDER=noreply@turingtech.com.ec
MAIL_FROM_NAME=TURINGTECH

# Email SMTP (fallback para desarrollo local)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASSWORD=tu-app-password

# App
APP_URL=http://localhost:3000
INITIAL_CREDITS=2000
ADMIN_EMAIL=admin@turingtech.com.ec
ADMIN_PASSWORD=turingtech2026
NOTIFICATION_EMAIL=nicole.flores@turingtech.com.ec
